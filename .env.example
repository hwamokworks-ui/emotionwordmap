# Supabase — copy this file to .env.local and fill in real values.
# No NEXT_PUBLIC_ prefix: these stay server-only (Route Handlers / Server Actions / Server Components),
# never bundled into client-side JS, per this project's "DB code lives server-side" rule.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Not currently used by any script or the running app — kept for future one-time admin scripts.
SUPABASE_SERVICE_ROLE_KEY=
# OpenRouter — used for LLM-based free-text search matching (lib/ai-match.ts). Server-only.
OPENROUTER_API_KEY=
